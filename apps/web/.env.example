# apps/web — متغیرهای Next.js (سایت عمومی)
# ─────────────────────────────────────────────────────────────────────────────
# در development این فایل را از ریشه monorepo کپی یا symlink کنید:
#   copy ..\.env.example .env.local
# حداقل متغیرهای لازم:
#   DATABASE_URL, AUTH_SECRET, REVALIDATE_SECRET, NEXT_PUBLIC_SITE_URL
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/db_vargah?schema=public"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
REVALIDATE_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_CDN_URL=""

# OTP مشتری — sandbox در development
# CUSTOMER_OTP_SANDBOX="true"

# سئو / تحلیل
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# درگاه (fallback — تنظیم اصلی در DB)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# =============================================================================
# ماهنامه وارگه — متغیرهای محیطی (Monorepo)
# =============================================================================
# ۱. کپی:  copy .env.example .env
# ۲. مقادیر را پر کنید — هرگز .env را commit نکنید
# ۳. Prisma از DATABASE_URL ریشه استفاده می‌کند
# ۴. در dev می‌توانید .env را به apps/web و apps/admin به‌صورت .env.local کپی کنید
#    (جزئیات: docs/SETUP.md)
# ۵. استقرار: docs/DEPLOY.md
# =============================================================================

# ─── PostgreSQL (الزامی) ───────────────────────────────────────────────────────
# فرمت: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/db_vargah?schema=public"

# مرجع (Prisma مستقیماً نمی‌خواند — برای اسکریپت/مستندات)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="YOUR_PASSWORD"
POSTGRES_DB="db_vargah"
POSTGRES_SCHEMA="public"

# اتصال مستقیم برای migration در صورت PgBouncer (اختیاری)
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/db_vargah?schema=public"

# ─── محیط اجرا ─────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Auth.js — پنل مدیریت (الزامی) ───────────────────────────────────────────
# تولید: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000/admin/api/auth"

# 2FA اجباری TOTP برای نقش‌های حساس
# در production به‌صورت پیش‌فرض فعال است؛ برای خاموش کردن:
# MANDATORY_2FA_ENABLED="false"
# در development فقط با true روشن می‌شود:
# MANDATORY_2FA_ENABLED="true"

# OTP sandbox فقط در development — در production باعث خطا / خطر امنیتی می‌شود
# CUSTOMER_OTP_SANDBOX="true"
# ADMIN_OTP_SANDBOX="true"

# کلید رمزنگاری اسرار تنظیمات (الزامی در production)
# تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=""

# ─── Cron / Job داخلی ─────────────────────────────────────────────────────────
CRON_SECRET="change-me-generate-with-openssl-rand-base64-32"
JOB_WORKER_CONCURRENCY="5"
JOB_BATCH_SIZE="40"

# آدرس داخلی پنل (proxy از web به admin در dev)
ADMIN_INTERNAL_URL="http://127.0.0.1:3001"

# مسیر عمومی پنل (پیش‌فرض /admin)
# NEXT_PUBLIC_ADMIN_BASE_PATH="/admin"

# ─── CMS API (NestJS) ─────────────────────────────────────────────────────────
CMS_API_KEY="change-me-generate-with-openssl-rand-base64-32"
API_PORT=4000
API_URL="http://localhost:4000"

# ─── URLهای عمومی (الزامی برای build و callback) ─────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_CDN_URL=""

# ─── کش / Revalidation ────────────────────────────────────────────────────────
REVALIDATE_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── سئو و تحلیل (اختیاری) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ─── SMS — fallback env (تنظیم اصلی از پنل > تنظیمات) ───────────────────────
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
SMS_IR_API_KEY=""
SMS_IR_LINE_NUMBER=""

# ─── درگاه پرداخت — fallback env (تنظیم اصلی از پنل > تنظیمات) ───────────────
PAYMENT_PROVIDER="zarinpal"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# ─── Object Storage — S3-compatible (آروان / MinIO) ───────────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION="ir-thr-at1"

# ─── مانیتورینگ (اختیاری) ─────────────────────────────────────────────────────
SENTRY_DSN=""

# ─── تست E2E (اختیاری — Playwright) ───────────────────────────────────────────
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
# ADMIN_E2E_EMAIL="writer@magazine.ir"
# ADMIN_E2E_PASSWORD="writer1234"
